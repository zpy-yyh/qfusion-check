#!/usr/bin/expect -f
# 自动输入密码的scp脚本

set timeout 60
set password [lindex $argv 0]
set source [lindex $argv 1]
set destination [lindex $argv 2]

# 执行scp命令
spawn scp $source $destination

# 等待密码提示
expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    "yes/no" {
        send "yes\r"
        exp_continue
    }
    timeout {
        puts "连接超时"
        exit 1
    }
    eof {
        # 传输完成
    }
}

# 等待命令完成
expect eof
