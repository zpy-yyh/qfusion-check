#!/usr/bin/expect

set timeout 30
set node_file [lindex $argv 0]

# 读取节点配置
set fp [open "$node_file" r]
set file_data [read $fp]
close $fp

foreach line [split $file_data "\n"] {
    if {[string trim $line] eq ""} continue
    if {[regexp {^#} $line]} continue

    set fields [split [string trim $line]]
    if {[llength $fields] < 5} continue

    set ip [lindex $fields 0]
    set hostname [lindex $fields 1]
    set role [lindex $fields 2]
    set user [lindex $fields 3]
    set password [lindex $fields 4]

    puts "\n=========================================="
    puts "节点: $ip ($hostname)"
    puts "=========================================="

    spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null $user@$ip

    expect {
        "password:" {
            send "$password\r"
            expect {
                -re {#|\$} {
                    # 检查网络连通性
                    puts "\n=== 1. 网络连通性检查 ==="
                    send "ping -c 1 -W 2 114.114.114.114 2>&1 || echo '外网不通'\r"
                    expect -re {#|\$} { sleep 1 }

                    # 检查YUM源配置
                    puts "\n=== 2. YUM源配置文件 ==="
                    send "ls -lh /etc/yum.repos.d/*.repo 2>&1 | head -20\r"
                    expect -re {#|\$} { sleep 1 }

                    # 检查本地ISO挂载
                    puts "\n=== 3. 本地ISO挂载状态 ==="
                    send "mount | grep -E 'cdrom|iso' || echo '未挂载ISO'\r"
                    expect -re {#|\$} { sleep 1 }

                    # 测试YUM makecache
                    puts "\n=== 4. YUM缓存测试 (10秒超时) ==="
                    send "timeout 10 yum makecache 2>&1\r"
                    expect {
                        -timeout {
                            puts "\n[超时] YUM makecache 操作超时"
                            send "\r"
                            expect -re {#|\$}
                        }
                        -re {#|\$} { sleep 1 }
                    }

                    # 显示YUM仓库列表
                    puts "\n=== 5. YUM仓库列表 ==="
                    send "yum repolist 2>&1 | head -30\r"
                    expect -re {#|\$} { sleep 1 }

                    send "exit\r"
                    expect eof
                }
            }
        }
        "Connection refused" {
            puts "\n[错误] 连接被拒绝 ($ip)"
            continue
        }
        timeout {
            puts "\n[错误] 连接超时 ($ip)"
            continue
        }
    }
}

puts "\n=========================================="
puts "检查完成"
puts "=========================================="
