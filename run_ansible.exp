#!/usr/bin/expect -f
# 运行ansible playbook的expect脚本

set timeout 300
set password "Cljslrl0620!"
set command [lindex $argv 0]

# 设置环境变量，让ansible使用sshpass
set env(ANSIBLE_HOST_KEY_CHECKING) "false"

# 执行命令
spawn bash -c "$command"

expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    "yes/no" {
        send "yes\r"
        exp_continue
    }
    timeout {
        # 可能还在执行中，继续等待
        exp_continue
    }
    eof {
        # 命令完成
    }
}

expect eof
